# =============================================================================
# ProjectCamp Backend — Environment Variables
# =============================================================================
# Every variable below is read somewhere in src/. Filling in MONGO_URI and the
# two JWT secrets is enough to boot the server; the mail settings only matter
# once you exercise registration, email verification, or password reset.
# Do not commit this file once it contains real credentials.

# -----------------------------------------------------------------------------
# Server  — src/index.js, src/app.js
# -----------------------------------------------------------------------------
# Render assigns PORT automatically; this value only applies to local runs.
# For local development keep PORT=8000 and point client/.env at
# http://localhost:8000/api/v1.
PORT=8000

# Allowed CORS origins, comma-separated. Must include the deployed frontend and
# the Vite dev server, or the browser will block every request from the frontend.
# Exact match, no trailing slash.
CORS_ORIGIN=https://project-camp-fnza.vercel.app,http://localhost:5173

# -----------------------------------------------------------------------------
# Database — src/db/index.js
# -----------------------------------------------------------------------------
# Local MongoDB:
#   MONGO_URI=mongodb://127.0.0.1:27017/projectcamp
# Atlas (free tier) — replace <username>, <password>, <cluster>:
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/projectcamp?retryWrites=true&w=majority
MONGO_URI=

# -----------------------------------------------------------------------------
# JWT — src/models/user.models.js, src/middlewares/auth.middleware.js
# -----------------------------------------------------------------------------
# Generate each secret separately, never reuse the same value for both:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# -----------------------------------------------------------------------------
# Email — src/utils/mail.js
# -----------------------------------------------------------------------------
# Mailtrap is a test inbox: mail is captured, never delivered to real people.
# Sign up at https://mailtrap.io, open Email Testing -> Inboxes -> Show
# Credentials, and copy the SMTP values here.
# Leaving these blank does not crash the server — sendEmail catches and logs
# the failure — but no verification or reset links will ever arrive.
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# -----------------------------------------------------------------------------
# Password reset link — src/controllers/auth.controllers.js
# -----------------------------------------------------------------------------
# The reset token is appended as `<this value>/<token>`, so this must point at
# the frontend route without a trailing slash. The frontend serves
# /reset-password/:resetToken, which matches the value below.
FORGOT_PASSWORD_REDIRECT_URL=https://project-camp-fnza.vercel.app/reset-password

# -----------------------------------------------------------------------------
# File uploads — src/controllers/task.controllers.js
# -----------------------------------------------------------------------------
# Public base URL of this backend. Attachment URLs are built as
# `<SERVER_URL>/images/<filename>`, and files are served from public/ as static
# assets, so this must be reachable from the browser.
SERVER_URL=https://project-camp-server.onrender.com
